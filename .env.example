# ============ XUI-VPS 配置示例（复制为 .env 使用） ============

# 服务端口（默认 8787）
PORT=8787

# 数据库文件路径（默认 ./data/xui.db，Docker 挂载卷）
# DATABASE_PATH=/data/xui.db

# ---- 面板管理员（必改！）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---- 住宅代理（可选，默认关闭；配置后自动启用）----
# PROXY_USER=
# PROXY_PASS=

# ---- Telegram 机器人（可选）----
# 机器人 token（@BotFather 获取）与你的 TG 数字 ID
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# Webhook 校验密钥（建议设置随机串；面板保存 TG 设置时自动注册 webhook）
# TG_WEBHOOK_SECRET=

# ---- Cron 离线检查密钥（可选，外部触发 /api/cron/check 用）----
# CRON_SECRET=

# ---- 外部住宅代理控制器（可选，高级）----
# PROXY_CTRL_URL=
# PROXY_CTRL_USER=
# PROXY_CTRL_PASS=
# PROXY_CTRL_TOKEN=

# 面板域名（用于 TG webhook 注册与通知，例 https://xui.example.com）
# PAGES_ORIGIN=
